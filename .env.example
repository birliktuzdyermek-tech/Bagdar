# Секретов прототипу не нужно: он работает без внешних API и платных сервисов.
# Все параметры — через переменные окружения.

# Путь к YAML-конфигу весов и порогов (по умолчанию backend/config/default.yaml)
BAGDAR_CONFIG=
# Сценарий при старте сервера (файл backend/scenarios/<id>.yaml)
BAGDAR_SCENARIO=normal
# Каталог сценариев (по умолчанию backend/scenarios)
BAGDAR_SCENARIOS=
# Разрешённые источники для CORS (через запятую), нужен только без прокси Vite
BAGDAR_CORS_ORIGINS=http://localhost:5173
# Уровень логов: DEBUG | INFO | WARNING
BAGDAR_LOG_LEVEL=INFO
# Где лежит собранный фронтенд, который backend раздаёт с того же порта
BAGDAR_FRONTEND_DIST=
# Адрес backend для dev-прокси Vite
BAGDAR_BACKEND=http://localhost:8000
