{
 "openapi": "3.1.0",
 "info": {
  "title": "Бағдар API",
  "description": "\n**Бағдар** — консультативный автодиспетчер железнодорожного участка.\n\nДемонстрационный прототип на синтетических данных. **Не система управления\nдвижением**: не управляет реальными сигналами, стрелками и поездами и не\nзаменяет устройства СЦБ. Веса, цены и «сэкономленные деньги» условные.\n\nПоток реального времени: `ws /api/stream` (формат — `GET /api/stream/schema`).\n",
  "version": "0.1.0"
 },
 "paths": {
  "/api/health": {
   "get": {
    "tags": [
     "service"
    ],
    "summary": "Health",
    "operationId": "health_api_health_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HealthOut"
        }
       }
      }
     }
    }
   }
  },
  "/api/world": {
   "get": {
    "tags": [
     "state"
    ],
    "summary": "Инфраструктура участка и состав поездов с исходным расписанием",
    "operationId": "get_world_api_world_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/WorldOut"
        }
       }
      }
     }
    }
   }
  },
  "/api/state": {
   "get": {
    "tags": [
     "state"
    ],
    "summary": "Текущее состояние участка",
    "operationId": "get_state_api_state_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/StateOut"
        }
       }
      }
     }
    }
   }
  },
  "/api/plan": {
   "get": {
    "tags": [
     "state"
    ],
    "summary": "Действующий план движения",
    "operationId": "get_plan_api_plan_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/PlanOut"
        }
       }
      }
     }
    }
   }
  },
  "/api/events": {
   "get": {
    "tags": [
     "state"
    ],
    "summary": "Журнал событий текущего прогона",
    "operationId": "get_events_api_events_get",
    "parameters": [
     {
      "name": "since",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer",
       "minimum": 0,
       "default": 0,
       "title": "Since"
      }
     },
     {
      "name": "limit",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer",
       "maximum": 20000,
       "minimum": 1,
       "default": 500,
       "title": "Limit"
      }
     },
     {
      "name": "min_severity",
      "in": "query",
      "required": false,
      "schema": {
       "enum": [
        "debug",
        "info",
        "warn",
        "critical"
       ],
       "type": "string",
       "default": "debug",
       "title": "Min Severity"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/EventsOut"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/scenarios": {
   "get": {
    "tags": [
     "scenarios"
    ],
    "summary": "Get Scenarios",
    "operationId": "get_scenarios_api_scenarios_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "items": {
          "$ref": "#/components/schemas/ScenarioOut"
         },
         "type": "array",
         "title": "Response Get Scenarios Api Scenarios Get"
        }
       }
      }
     }
    }
   }
  },
  "/api/sim/control": {
   "post": {
    "tags": [
     "simulation"
    ],
    "summary": "Старт, пауза, ускорение ×1…×100, шаг, сброс",
    "operationId": "sim_control_api_sim_control_post",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/ControlIn"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ControlOut"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/sim/load": {
   "post": {
    "tags": [
     "simulation"
    ],
    "summary": "Загрузить сценарий и/или сгенерировать мир с новым seed",
    "operationId": "sim_load_api_sim_load_post",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/LoadIn"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/LoadOut"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/config": {
   "get": {
    "tags": [
     "config"
    ],
    "summary": "Веса, пороги, параметры",
    "operationId": "get_config_api_config_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/BagdarConfig"
        }
       }
      }
     }
    }
   }
  },
  "/api/stream/schema": {
   "get": {
    "tags": [
     "stream"
    ],
    "summary": "Формат сообщений WebSocket /api/stream на живых данных",
    "operationId": "stream_schema_api_stream_schema_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/StreamSchema"
        }
       }
      }
     }
    }
   }
  }
 },
 "components": {
  "schemas": {
   "BagdarConfig": {
    "properties": {
     "mode": {
      "type": "string",
      "enum": [
       "mainline",
       "lrt"
      ],
      "title": "Mode",
      "default": "mainline"
     },
     "pte_strict": {
      "type": "boolean",
      "title": "Pte Strict",
      "default": true
     },
     "index": {
      "$ref": "#/components/schemas/IndexConfig",
      "default": {
       "weights": {
        "conflicts": 0.1,
        "punctuality": 0.25,
        "resource_idle": 0.15,
        "throughput": 0.3,
        "track_load": 0.2
       },
       "thresholds": {
        "normal": 75.0,
        "warning": 50.0
       },
       "punctuality_max_delay_min": 30.0,
       "conflicts_max": 10.0
      }
     },
     "priority": {
      "additionalProperties": {
       "$ref": "#/components/schemas/PriorityEntry"
      },
      "type": "object",
      "title": "Priority"
     },
     "cost": {
      "$ref": "#/components/schemas/CostConfig",
      "default": {
       "c_stop": 0.5,
       "c_energy": 0.1,
       "c_idle": 2.0,
       "c_change": 15.0
      }
     },
     "solver": {
      "$ref": "#/components/schemas/SolverConfig",
      "default": {
       "horizon_min": 180.0,
       "freeze_min": 5.0,
       "time_limit_s": 2.0,
       "fallback": "greedy"
      }
     },
     "sim": {
      "$ref": "#/components/schemas/SimConfig",
      "default": {
       "dt_s": 1.0,
       "start_time": "06:00",
       "tau_cross_s": 90.0,
       "headway_s": 300.0,
       "headway_arr_s": 180.0,
       "throat_s": 90.0,
       "approach_s": 90.0,
       "clear_s": 60.0,
       "prep_s": 600.0,
       "terminate_s": 600.0,
       "min_stop_s": 30.0,
       "recovery_margin": 0.07,
       "max_wait_s": 3600.0,
       "dwell_jitter_prob": 0.25,
       "dwell_jitter_max_s": 90.0,
       "origin_delay_prob": 0.12,
       "origin_delay_max_s": 300.0,
       "broadcast_hz": 10.0
      }
     }
    },
    "type": "object",
    "title": "BagdarConfig"
   },
   "ControlIn": {
    "properties": {
     "action": {
      "type": "string",
      "enum": [
       "start",
       "pause",
       "speed",
       "step",
       "reset"
      ],
      "title": "Action"
     },
     "speed": {
      "anyOf": [
       {
        "type": "number",
        "maximum": 100.0,
        "minimum": 1.0
       },
       {
        "type": "null"
       }
      ],
      "title": "Speed"
     },
     "step_s": {
      "anyOf": [
       {
        "type": "number",
        "maximum": 3600.0,
        "exclusiveMinimum": 0.0
       },
       {
        "type": "null"
       }
      ],
      "title": "Step S",
      "description": "Шаг в секундах модели (по умолчанию 60)"
     }
    },
    "type": "object",
    "required": [
     "action"
    ],
    "title": "ControlIn"
   },
   "ControlOut": {
    "properties": {
     "running": {
      "type": "boolean",
      "title": "Running"
     },
