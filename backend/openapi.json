      "title": "Station Id"
     },
     "section_id": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Section Id"
     },
     "data": {
      "additionalProperties": true,
      "type": "object",
      "title": "Data"
