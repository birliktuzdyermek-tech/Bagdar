    },
    "type": "object",
    "required": [
     "running",
     "speed",
     "t",
     "run_id"
    ],
    "title": "ControlOut"
   },
   "CostConfig": {
    "properties": {
     "c_stop": {
      "type": "number",
      "title": "C Stop",
